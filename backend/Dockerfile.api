FROM python:3.13-slim-bookworm AS build

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:0.13.10 /uv /uvx /bin/
WORKDIR /srv/agent-k
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY agent_k ./agent_k
COPY README.md ./
RUN uv sync --frozen --no-dev

FROM python:3.13-slim-bookworm

ENV PATH=/srv/agent-k/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 10001 agentk \
    && useradd --uid 10001 --gid agentk --home-dir /nonexistent --shell /usr/sbin/nologin agentk
WORKDIR /srv/agent-k
COPY --from=build --chown=agentk:agentk /srv/agent-k /srv/agent-k
USER agentk
EXPOSE 9000
CMD ["python", "-m", "uvicorn", "agent_k.api:app", "--host", "0.0.0.0", "--port", "9000"]
